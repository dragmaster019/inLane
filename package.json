{
  "name": "inlane-telemetry-ingest",
  "version": "1.0.0",
  "description": "High-frequency motion telemetry ingestion + query service (local MySQL, no AWS)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:migrate": "mysql -h ${DB_HOST:-127.0.0.1} -u ${DB_USER:-root} -p < sql/001_create_telemetry_db.sql",
    "test:ingest": "node scripts/smoke-ingest.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.11.0"
  }
}
